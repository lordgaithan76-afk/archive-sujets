.socials a { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--border); color: var(--text-2); }

.socials a:hover { background: var(--primary); color: rgb(255, 255, 255); border-color: var(--primary); }

.wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 70; display: inline-flex; align-items: center; gap: 10px; background: var(--wa); color: rgb(6, 48, 26); font-family: var(--ff-title); font-weight: 700; font-size: 0.93rem; padding: 13px 19px; border-radius: var(--r-pill); box-shadow: rgba(37, 211, 102, 0.42) 0px 10px 30px; transition: transform 0.2s; }

.wa-float:hover { transform: translateY(-3px); text-decoration: none; color: rgb(6, 48, 26); }

@media (max-width: 520px) {
  .wa-float span { display: none; }
  .wa-float { padding: 15px; }
}

.tag-row { display: flex; flex-wrap: wrap; gap: 8px; }

.hr { height: 1px; background: var(--border); border: 0px; margin: 34px 0px; }

.center { text-align: center; }

.mt-0 { margin-top: 0px; }

.mb-0 { margin-bottom: 0px; }

.muted { color: var(--muted); }

.small { font-size: 0.88rem; }

.notice { border: 1px dashed var(--or); background: var(--or-soft); color: rgb(122, 83, 0); border-radius: var(--r); padding: 14px 18px; font-size: 0.92rem; }

html[data-theme="dark"] .notice { color: rgb(255, 217, 138); }

@media print {
  .header, .footer, .wa-float, .btn { display: none !important; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation: auto ease 0s 1 normal none running none !important; transition: none !important; scroll-behavior: auto !important; }
}
